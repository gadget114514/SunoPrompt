{
  "name": "suno-prompt-generator",
  "version": "1.0.0",
  "description": "Suno AI用のプロンプト自動生成ツール",
  "main": "main.js",
  "homepage": "./",
  "bin": {
    "suno-prompt-generator": "launcher.js"
  },
  "scripts": {
    "start": "electron .",
    "debug": "electron . --remote-debugging-port=9222",
    "dev": "electron .",
    "launch": "node launcher.js",
    "package": "pkg launcher.js --targets node18-win-x64 --output suno-prompt-generator.exe",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "suno",
    "prompt",
    "generator",
    "music"
  ],
  "author": "gadget114514",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.gadget114514.sunopromptgenerator",
    "productName": "SunoPromptGenerator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "*.json",
      "!package-lock.json",
      "images/application.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "images/application.ico"
    },
    "portable": {
      "artifactName": "SunoPromptGenerator.exe"
    }
  }
}
